{
  "name": "webhook-bench",
  "version": "1.0.0",
  "description": "Webhook debugging bench — catch, inspect and replay any webhook",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["webhook", "debugging", "testing", "replay"],
  "author": "v01dst",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "fastify": "^5.12.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
